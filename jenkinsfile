pipeline {
    agent { node { label 'terraform-node' } } 
    parameters {
                choice(name: 'Deployment_Type', choices:['apply','destroy'],description:'The deployment type')
                  }
    environment {
        EMAIL_TO = 'bolarinwaibrahimo@gmail.com'
    }
    stages {
        stage('1. Checkout Terraform Code') {
            steps {
                git branch: 'dev', url: 'https://github.com/grandtech001/capstone-project.git'
            }
        }

        stage('2.Terraform init') {
            steps {
                dir('eks'){
                    echo 'terraform init phase'
                    sh 'terraform init'
                }
            }
        }
        stage('3.Terraform plan') {
            steps {
                 dir('eks'){
                    echo 'terraform plan phase'
                    sh 'AWS_REGION=us-west-2 terraform plan'
                }
            }
        }
        stage('4.Manual Approval') {
            input {
                message "Should we proceed?"
                ok "Yes, we should."
                parameters{
                    choice (name: 'Manual_Approval', choices: ['Approve','Reject'], description: 'Approve or Reject the deployment')
                }
            }
            steps {
                script {
                    if (params.Manual_Approval == 'Reject') {
                        echo "Deployment was rejected. Exiting pipeline."
                        error "Pipeline aborted by user."
                    }
                    else {
                        echo "Deployment approved, proceeding"
                    }
                }
            }
        }
        stage('5.Terraform Deploy') {              
            steps {
                dir('eks'){
                    script{
                        try{
                            echo 'Terraform ${params.Deployment_Type} phase'
                            sh "AWS_REGION=us-west-2 terraform ${params.Deployment_Type} --auto-approve"
                            } catch (Exception e) {
                            echo 'Terraform deployment failed: ${e}'
                            error 'Stopping pipeline due to failure'
                        }
                    } 
                }
            } 
        }
        stage ('6. Email Notification') {
            steps {
                script {
                try {
                       mail bcc: 'bolarinwaibrahimo@gmail.com', 
                       body: '''Terraform deployment is completed.
                        Let me know if the changes look okay.
                        Thanks,
                        Jide Domain System Technologies,
              +44 7887768539''', cc: 'bolarinwaibrahimo@gmail.com', from: '', replyTo: '', subject: 'Terraform Infra deployment completed!!!', to: 'sarahajibola40@gmail.com'
                          
               }  
               catch (Exception e) {
                        echo "Failed to send email notification: ${e}"
               }  
            }
          }
        } 
     }       
} 
