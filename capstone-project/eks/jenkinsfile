pipeline {
    agent { node { label 'terraform-node' } } 

    parameters {
        choice(name: 'Deployment_Type', choices:['apply','destroy'], description: 'The deployment type')
    }

    environment {
        EMAIL_TO = 'lawalolorunfemi@gmail.com'
    }

    stages {
        stage('1. Terraform init') {
            when {
                expression { params.Deployment_Type == "apply" }  // Skip for destroy
            }
            steps {
                dir('eks') {
                    echo 'terraform init phase'
                    sh 'terraform init'
                }
            }
        }

        stage('2. Terraform plan') {
            when {
                expression { params.Deployment_Type == "apply" }  // Skip for destroy
            }
            steps {
                dir('eks') {
                    echo 'terraform plan phase'
                    sh 'AWS_REGION=us-east-1 terraform plan'
                }
            }
        }

        stage('3. Manual Approval') {
            input {
                message "Should we proceed?"
                ok "Yes, we should."
                parameters {
                    choice(name: 'Manual_Approval', choices: ['Approve','Reject'], description: 'Approve or Reject the deployment')
                }
            }
            steps {
                echo "Deployment ${params.Manual_Approval}"
            }          
        }

        stage('4. Terraform Deploy/Destroy') {              
            steps { 
                dir('eks') {
                    echo "Terraform ${params.Deployment_Type} phase"
                    sh "AWS_REGION=us-east-1 terraform ${params.Deployment_Type} --auto-approve"
                    
                    // Run only for apply (Skip these for destroy)
                    script {
                        if (params.Deployment_Type == "apply") {
                            sh "chmod +x kubeconfig.sh helm.sh"
                            sh "bash kubeconfig.sh"
                            sh "bash helm.sh"
                        }
                    }
                }
            }
        }

        stage('5. Email Notification') {
            steps {
                dir('eks') {
                    script {
                        try {
                            emailext(
                                from: 'femithecoder@gmail.com',
                                to: "${EMAIL_TO}",
                                subject: "Terraform ${params.Deployment_Type} Completed!",
                                body: """<p>Terraform ${params.Deployment_Type} is completed.</p>
                                         <p>Check build logs: <a href='${env.BUILD_URL}'>${env.BUILD_URL}</a></p>""",
                                mimeType: 'text/html'
                            )
                        } catch (Exception e) {
                            echo "Failed to send email: ${e.message}"
                        }  
                    }
                }
            }
        }
    }
}
